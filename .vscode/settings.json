{
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "[markdown]": {
    "editor.wordWrap": "on",
    "editor.quickSuggestions": { "other": "off", "comments": "off", "strings": "off" },
    "files.trimTrailingWhitespace": false
  },
  "markdown.extension.toc.levels": "2..3",
  "search.exclude": {
    "**/bin": true,
    "**/obj": true,
    "**/.venv": true
  }
}
